# ============================================================
# SIMS 환경 변수 목록
# - 복사해서 .env를 만들고 실제 값을 채웁니다: cp .env.example .env
# - .env는 절대 커밋하지 않습니다 (.gitignore에 등록됨)
# - 아래 값은 모두 예시이며, 실제 도메인·비밀번호를 여기에 쓰지 않습니다
# - 값에 '$' 문자를 쓰지 않습니다 (docker compose가 변수로 해석해 값이 깨짐)
# ============================================================

# ---------- Django ----------
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=sims.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://sims.example.com

# ---------- PostgreSQL ----------
DB_NAME=sims
DB_USER=sims_user
DB_PASSWORD=change-me
DB_HOST=sims_postgres
DB_PORT=5432

# ---------- Microsoft SSO (Entra ID, 단일 테넌트) ----------
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_REDIRECT_URI=https://sims.example.com/accounts/microsoft/callback/

# ---------- Reverse Proxy (도메인 연결) ----------
VIRTUAL_HOST=sims.example.com
VIRTUAL_PORT=8000
VIRTUAL_PROTO=http
